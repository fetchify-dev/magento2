{
    "name": "fetchify/module-fetchify",
    "description": "Adds data capture and validation products by Fetchify (previously Crafty Clicks) to Magento 2.",
    "type": "magento2-module",
    "version": "2.10.1",
    "authors": [
        {
            "name": "Gabor Peter Suranyi",
            "homepage": "https://fetchify.com/",
            "role": "Developer"
        },
        {
            "name": "Paul Maxwell",
            "homepage": "https://fetchify.com/",
            "role": "Developer"
        }
    ],
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
          "Fetchify\\Fetchify\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
